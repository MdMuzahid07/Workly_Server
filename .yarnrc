# .yarnrc — P11 supply-chain controls (yarn 1 partial coverage)
#
# Q5 decision: staying on yarn 1 for now; full P11 controls (ignore-scripts,
# min-release-age) require npm ≥ 11.10.0 or yarn 4 berry. Migrate to achieve
# full coverage when the package manager decision is finalised.
#
# save-exact true: new `yarn add <pkg>` pins exact versions (1.2.3) instead of
# caret ranges (^1.2.3) — prevents silent minor/patch updates on next install.
# Existing ranges in package.json are unaffected; apply with `yarn upgrade`.

save-exact true
