generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//* ====== enums ======>

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  REMOTE
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  EXPIRED
}

enum JobSkillPriority {
  HIGH
  MEDIUM
  LOW
  GOOD_TO_HAVE
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGE
  NEW_JOB_MATCH
  JOB_EXPIRING
  JOB_CLOSED
  MESSAGE_RECEIVED
  SYSTEM_ANNOUNCEMENT
  PROFILE_INCOMPLETE
  INTERVIEW_SCHEDULED
  PROFILE_VIEWED
  JOB_VIEWED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  REJECTED
  OFFERED
  ACCEPTED
  WITHDRAWN
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  BOTH
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  LOGIN_MAGIC_LINK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  REFUNDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

//* ====== user & profile ======>
model User {
  id                String            @id @default(uuid())
  email             String            @unique @db.VarChar(255)
  passwordHash      String            @db.VarChar(255)
  fullName          String            @db.VarChar(255)
  phone             String?           @db.VarChar(50)
  role              UserRole          @default(JOB_SEEKER)
  isVerified        Boolean           @default(false)
  isActive          Boolean           @default(true)
  profileId         String?           @unique
  profileVisibility ProfileVisibility @default(PUBLIC)
  companyId         String?
  lastLogin         DateTime?
  deletedAt         DateTime?

  //* ==== relations =====>
  // applications       Application[]
  // jobsPosted         Job[]               @relation("JobPoster")
  // notifications      Notification[]
  // savedJobs          SavedJob[]
  // company            Company?            @relation(fields: [companyId], references: [id])
  // profile            Profile?            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // verificationTokens VerificationToken[]

  @@index([email, isActive])
  @@index([role, isActive])
  @@index([companyId])
  @@index([lastLogin])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id                   String  @id @default(uuid())
  userId               String  @unique
  //* ==== personal =====>
  bio                  String?
  location             String? @db.VarChar(255)
  avatarUrl            String? @db.VarChar(500)
  coverUrl             String? @db.VarChar(500)
  resumeUrl            String? @db.VarChar(500)
  linkedInUrl          String? @db.VarChar(500)
  websiteUrl           String? @db.VarChar(500)
  //* ==== professional ======>
  headline             String? @db.VarChar(255)
  totalExperienceYears Float?
  //* ==== relations ======>
  // preference           Preference?
  // skills               Skill[]
  // user                 User?

  @@index([userId])
  @@map("profiles")
}

model Education {
  id           String    @id @default(uuid())
  profileId    String
  institution  String    @db.VarChar(255)
  degree       String    @db.VarChar(255)
  fieldOfStudy String?   @db.VarChar(255)
  startDate    DateTime?
  endDate      DateTime?
  grade        String?   @db.VarChar(50)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  //* ==== relations ======>
  // profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([institution])
  @@map("education")
}

model WorkExperience {
  id          String    @id @default(uuid())
  profileId   String
  jobTitle    String    @db.VarChar(255)
  company     String    @db.VarChar(255)
  location    String?   @db.VarChar(255)
  startDate   DateTime?
  endDate     DateTime?
  description String?
  current     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //* ==== relations ======>
  // profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
  @@map("work_experience")
}

model Certification {
  id            String    @id @default(uuid())
  profileId     String
  name          String    @db.VarChar(255)
  issuingOrg    String    @db.VarChar(255)
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?   @db.VarChar(255)
  credentialUrl String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  //* ==== relations ======>
  // profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([name])
  @@map("certifications")
}

model Skill {
  id              String  @id @default(uuid())
  skillName       String  @db.VarChar(100)
  experienceYears Float
  profileId       String
  jobId           String?
  //* ==== relations ======>
  // Job             Job?    @relation(fields: [jobId], references: [id])
  // profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([skillName])
  @@map("skills")
}

model Preference {
  id                String   @id @default(uuid())
  profileId         String   @unique
  jobType           JobType  @default(FULL_TIME)
  expectedSalary    Int?
  preferredLocation String?  @db.VarChar(255)
  remoteWork        Boolean  @default(false)
  industry          String?  @db.VarChar(100)
  workExperience    String?  @db.VarChar(100)
  availability      String?  @db.VarChar(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  //* ==== relations ======>
  //profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("preferences")
}

//* ====== company & job ======>
model Company {
  id           String    @id @default(uuid())
  name         String    @unique @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  description  String?
  websiteUrl   String?   @db.VarChar(500)
  logoUrl      String?   @db.VarChar(500)
  coverUrl     String?   @db.VarChar(500)
  location     String?   @db.VarChar(255)
  mission      String?   @db.VarChar(1000)
  values       String[]  @default([])
  industryId   String?   @db.VarChar(100)
  size         String?   @db.VarChar(50)
  contactEmail String?   @db.VarChar(255)
  contactPhone String?   @db.VarChar(50)
  isVerified   Boolean   @default(false)
  founded      String?   @db.VarChar(100)
  verifiedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  //* ==== relations ======>
  // benefits     Benefits[]
  // industry     Industry?    @relation(fields: [industryId], references: [id])
  // jobs         Job[]
  // socialLinks  SocialLink[]
  // employees    User[]

  @@index([slug])
  @@index([isVerified, deletedAt])
  @@index([deletedAt])
  @@map("companies")
}

model Benefits {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  description String?
  category    String?  @db.VarChar(100)
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  jobId       String?
  //* ==== relations ======>
  // company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jobId])
  @@index([category])
  @@map("benefits")
}

model SocialLink {
  id        String @id @default(uuid())
  platform  String @db.VarChar(50)
  url       String @db.VarChar(500)
  companyId String
  //* ==== relations ======>
  // company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("social_links")
}

model Industry {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  active        Boolean   @default(true)
  description   String
  icon          String    @db.VarChar(50)
  subcategories String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  //* ==== relations ======>
  // companies     Company[]
  // jobs          Job[]

  @@index([slug])
  @@index([active])
  @@map("industries")
}

model Job {
  id                    String    @id @default(uuid())
  title                 String    @db.VarChar(255)
  slug                  String    @unique @db.VarChar(255)
  discipline            String    @db.VarChar(255)
  description           String
  requirements          String[]  @default([])
  jobType               JobType   @default(FULL_TIME)
  location              String    @db.VarChar(255)
  experienceLevel       String    @db.VarChar(50)
  isRemote              Boolean   @default(false)
  salaryMin             Int?
  salaryMax             Int?
  currency              String?   @db.VarChar(3)
  contactEmail          String?   @db.VarChar(255)
  applicationDeadline   DateTime?
  maxApplications       Int?
  autoCloseApplications Boolean   @default(false)
  status                JobStatus @default(DRAFT)
  isFeatured            Boolean   @default(false)
  expiresAt             DateTime?
  viewCount             Int       @default(0)
  applyCount            Int       @default(0)
  deletedAt             DateTime?
  benefits              String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  companyId             String
  postedById            String
  industryId            String?
  //* ==== relations ======>
  // applications          Application[]
  // Benefits              Benefits[]
  // JobSkill              JobSkill[]
  // company               Company        @relation(fields: [companyId], references: [id])
  // industry              Industry?      @relation(fields: [industryId], references: [id], onDelete: Restrict)
  // postedBy              User           @relation("JobPoster", fields: [postedById], references: [id])
  // notifications         Notification[] @relation("JobNotifications")
  // savedByUsers          SavedJob[]
  // skillsRequired        Skill[]

  @@index([companyId])
  @@index([location, isRemote])
  @@index([jobType, experienceLevel])
  @@index([isFeatured, createdAt])
  @@index([postedById])
  @@index([deletedAt])
  @@index([slug])
  @@map("jobs")
}

model JobSkill {
  id              String           @id @default(uuid())
  skillName       String           @db.VarChar(100)
  experienceYears Float
  isRequired      Boolean          @default(true)
  priority        JobSkillPriority @default(HIGH)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobId           String
  //* ==== relations ======>
  // job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([skillName])
  @@index([isRequired])
  @@index([priority])
  @@map("job_skills")
}

//* ====== application & saved jobs/candidate ======>
model Application {
  id                     String                 @id @default(uuid())
  status                 ApplicationStatus      @default(SUBMITTED)
  coverLetter            String?
  preferredContactMethod PreferredContactMethod @default(email)
  rejectionReason        String?
  statusChangedBy        String?
  statusChangedAt        DateTime?
  applicantData          String?                @default("")
  folderName             String?                @db.VarChar(100)
  fullName               String?                @db.VarChar(100)
  email                  String?                @db.VarChar(200)
  phone                  String?                @db.VarChar(50)
  resumeUrl              String?
  agreedTerms            Boolean                @default(true)
  yearsOfExperience      Int?
  currentLocation        String?                @db.VarChar(255)
  interviewScheduledAt   DateTime?
  interviewNotes         String?
  withdrawnAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  applicantId            String
  jobId                  String
  //* ==== relations ======>
  // applicant              User                   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // job                    Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // notifications          Notification[]

  @@unique([jobId, applicantId])
  @@index([applicantId, status])
  @@index([jobId, status])
  @@index([createdAt])
  @@index([statusChangedAt])
  @@map("applications")
}

model SavedJob {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  folderName String?  @db.VarChar(100)
  notes      String?
  createdAt  DateTime @default(now())
  //* ==== relations ======>
  // job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([folderName])
  @@map("saved_jobs")
}

model SavedCandidate {
  id          String   @id @default(uuid())
  employerId  String
  candidateId String
  folderName  String?  @db.VarChar(100)
  notes       String?
  createdAt   DateTime @default(now())
  //* ==== relations ======>
  // employer User @relation("SavedCandidates", fields: [employerId], references: [id], onDelete: Cascade)
  // candidate User @relation("SavedByEmployers", fields: [candidateId], references: [id], onDelete: Cascade)
}

//* ====== messaging ======>
model Conversation {
  id            String   @id @default(uuid())
  applicationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  //* ==== relations ======>
  // application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // participants   ConversationParticipant[]
  // messages       Message[]
  // lastMessageId  String?                     // denormalized for quick preview
  // lastMessage    Message?                    @relation("LastMessage", fields: [lastMessageId], references: [id])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  //* ==== relations ======>
  // conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  //* ==== relations ======>
  // conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // sender         User           @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([status])
  @@map("messages")
}

//* ====== notification ======>
model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String           @db.VarChar(255)
  message       String
  isRead        Boolean          @default(false)
  jobId         String?
  applicationId String?
  sentVia       String[]         @default(["in_app"])
  emailSentAt   DateTime?
  pushSentAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  userId        String
  application   Application?     @relation(fields: [applicationId], references: [id])
  job           Job?             @relation("JobNotifications", fields: [jobId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(255)
  action     String   @db.VarChar(50)
  oldValues  Json?
  newValues  Json?
  userId     String   @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  id          String   @id @default(uuid())
  identifier  String   @db.VarChar(255)
  endpoint    String   @db.VarChar(255)
  requests    Int      @default(1)
  windowStart DateTime @default(now())
  resets      DateTime

  @@unique([identifier, endpoint])
  @@index([windowStart])
  @@index([resets])
  @@map("rate_limits")
}

model VerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique @db.VarChar(255)
  type      TokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}
