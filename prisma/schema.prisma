generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//* ====== enums ======>

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  REMOTE
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  EXPIRED
}

enum JobSkillPriority {
  HIGH
  MEDIUM
  LOW
  GOOD_TO_HAVE
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGE
  NEW_JOB_MATCH
  JOB_EXPIRING
  JOB_CLOSED
  MESSAGE_RECEIVED
  SYSTEM_ANNOUNCEMENT
  PROFILE_INCOMPLETE
  INTERVIEW_SCHEDULED
  PROFILE_VIEWED
  JOB_VIEWED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  REJECTED
  OFFERED
  ACCEPTED
  WITHDRAWN
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  BOTH
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  LOGIN_MAGIC_LINK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  REFUNDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

//* ====== user & profile ======>
model User {
  id                String            @id @default(uuid())
  email             String            @unique @db.VarChar(255)
  passwordHash      String            @db.VarChar(255)
  fullName          String            @db.VarChar(255)
  phone             String?           @db.VarChar(50)
  role              UserRole          @default(JOB_SEEKER)
  isVerified        Boolean           @default(false)
  isActive          Boolean           @default(true)
  profileId         String?           @unique
  profileVisibility ProfileVisibility @default(PUBLIC)
  companyId         String?
  lastLogin         DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  //* ==== relations =====>
  applications       Application[]
  jobsPosted         Job[]                     @relation("JobPoster")
  notifications      Notification[]
  savedJobs          SavedJob[]
  company            Company?                  @relation(fields: [companyId], references: [id])
  profile            Profile?                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verificationTokens VerificationToken[]
  conversations      ConversationParticipant[]
  profileViews       ProfileView[]             @relation("ViewedUser")
  profileViewers     ProfileView[]             @relation("ViewerUser")
  jobViews           JobView[]
  followedCompanies  Follow[]
  resumes            Resume[]
  candidateSaves     SavedCandidate[]          @relation("SavedByEmployers") // as candidate being saved
  employerSaves      SavedCandidate[]          @relation("SavedCandidates") // as employer saving candidates
  userSettings       UserSettings?
  sentMessages       Message[]                 @relation("SenderMessages")
  auditLogs          AuditLog[]
  reports            JobReport[]

  @@index([email, isActive])
  @@index([role, isActive])
  @@index([companyId])
  @@index([lastLogin])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id                   String           @id @default(uuid())
  userId               String           @unique
  //* ==== personal =====>
  bio                  String?
  location             String?          @db.VarChar(255)
  avatarUrl            String?          @db.VarChar(500)
  coverUrl             String?          @db.VarChar(500)
  resumeUrl            String?          @db.VarChar(500)
  linkedInUrl          String?          @db.VarChar(500)
  websiteUrl           String?          @db.VarChar(500)
  githubUrl            String?          @db.VarChar(500)
  //* ==== professional ======>
  headline             String?          @db.VarChar(255)
  totalExperienceYears Float?
  //* ==== relations ======>
  preference           Preference?
  skills               Skill[]
  user                 User?
  education            Education[]
  workExperiences      WorkExperience[]
  certifications       Certification[]
  projects             Project[]
  volunteers           Volunteer[]
  awards               Award[]
  publications         Publication[]
  references           Reference[]
  languages            Language[]
  address              Address?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt

  @@index([userId])
  @@map("profiles")
}

model Education {
  id           String    @id @default(uuid())
  profileId    String
  institution  String    @db.VarChar(255)
  degree       String    @db.VarChar(255)
  fieldOfStudy String?   @db.VarChar(255)
  level        String?   @db.VarChar(100)
  year         String?   @db.VarChar(10)
  startDate    DateTime?
  endDate      DateTime?
  grade        String?   @db.VarChar(50)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  //* ==== relations ======>
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([institution])
  @@map("education")
}

model WorkExperience {
  id             String    @id @default(uuid())
  profileId      String
  jobTitle       String    @db.VarChar(255)
  company        String    @db.VarChar(255)
  location       String?   @db.VarChar(255)
  employmentType String?   @db.VarChar(100)
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  current        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  //* ==== relations ======>
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("work_experience")
}

model Certification {
  id            String    @id @default(uuid())
  profileId     String
  name          String    @db.VarChar(255)
  issuingOrg    String    @db.VarChar(255)
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?   @db.VarChar(255)
  credentialUrl String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  //* ==== relations ======>
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([name])
  @@map("certifications")
}

model Skill {
  id              String  @id @default(uuid())
  skillName       String  @db.VarChar(100)
  experienceYears Float
  profileId       String
  jobId           String?
  //* ==== relations ======>
  Job             Job?    @relation(fields: [jobId], references: [id])
  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([skillName])
  @@map("skills")
}

model Project {
  id           String    @id @default(uuid())
  profileId    String
  title        String    @db.VarChar(255)
  description  String?
  link         String?   @db.VarChar(500)
  repoUrl      String?   @db.VarChar(500)
  technologies String[]  @default([])
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  //* ==== relations ======>
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}

model Preference {
  id                String   @id @default(uuid())
  profileId         String   @unique
  jobType           JobType  @default(FULL_TIME)
  expectedSalary    Int?
  preferredLocation String?  @db.VarChar(255)
  remoteWork        Boolean  @default(false)
  industry          String?  @db.VarChar(100)
  workExperience    String?  @db.VarChar(100)
  availability      String?  @db.VarChar(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  //* ==== relations ======>
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("preferences")
}

//* ====== company & job ======>
model Company {
  id           String    @id @default(uuid())
  name         String    @unique @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  description  String?
  websiteUrl   String?   @db.VarChar(500)
  logoUrl      String?   @db.VarChar(500)
  coverUrl     String?   @db.VarChar(500)
  location     String?   @db.VarChar(255)
  mission      String?   @db.VarChar(1000)
  values       String[]  @default([])
  industryId   String?
  size         String?   @db.VarChar(50)
  contactEmail String?   @db.VarChar(255)
  contactPhone String?   @db.VarChar(50)
  isVerified   Boolean   @default(false)
  founded      String?   @db.VarChar(100)
  verifiedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  //* ==== relations ======>

  benefits        Benefits[]
  industry        Industry?        @relation(fields: [industryId], references: [id])
  jobs            Job[]
  socialLinks     SocialLink[]
  employees       User[]
  follows         Follow[]
  subscription    Subscription?
  invoices        Invoice[]
  companySettings CompanySettings?

  @@index([slug])
  @@index([isVerified, deletedAt])
  @@index([deletedAt])
  @@map("companies")
}

model Benefits {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  description String?
  category    String?  @db.VarChar(100)
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  jobId       String?
  //* ==== relations ======>
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jobId])
  @@index([category])
  @@map("benefits")
}

model SocialLink {
  id        String  @id @default(uuid())
  platform  String  @db.VarChar(50)
  url       String  @db.VarChar(500)
  companyId String
  //* ==== relations ======>
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("social_links")
}

model Industry {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  active        Boolean   @default(true)
  description   String?
  icon          String    @db.VarChar(50)
  subcategories String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  //* ==== relations ======>
  companies     Company[]
  jobs          Job[]

  @@index([slug])
  @@index([active])
  @@map("industries")
}

model Job {
  id                    String         @id @default(uuid())
  title                 String         @db.VarChar(255)
  slug                  String         @unique @db.VarChar(255)
  discipline            String         @db.VarChar(255)
  description           String
  requirements          String[]       @default([])
  jobType               JobType        @default(FULL_TIME)
  location              String         @db.VarChar(255)
  experienceLevel       String         @db.VarChar(50)
  isRemote              Boolean        @default(false)
  salaryMin             Int?
  salaryMax             Int?
  currency              String?        @db.VarChar(3)
  contactEmail          String?        @db.VarChar(255)
  applicationDeadline   DateTime?
  maxApplications       Int?
  autoCloseApplications Boolean        @default(false)
  status                JobStatus      @default(DRAFT)
  isFeatured            Boolean        @default(false)
  expiresAt             DateTime?
  viewCount             Int            @default(0)
  applyCount            Int            @default(0)
  deletedAt             DateTime?
  benefits              String[]       @default([])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  companyId             String
  postedById            String
  industryId            String?
  //* ==== relations ======>
  applications          Application[]
  Benefits              Benefits[]
  JobSkill              JobSkill[]
  company               Company        @relation(fields: [companyId], references: [id])
  industry              Industry?      @relation(fields: [industryId], references: [id], onDelete: Restrict)
  postedBy              User           @relation("JobPoster", fields: [postedById], references: [id])
  notifications         Notification[] @relation("JobNotifications")
  savedByUsers          SavedJob[]
  skillsRequired        Skill[]
  jobViews              JobView[]
  reports               JobReport[]

  @@index([companyId])
  @@index([location, isRemote])
  @@index([jobType, experienceLevel])
  @@index([isFeatured, createdAt])
  @@index([status, expiresAt, deletedAt])
  @@index([postedById])
  @@index([deletedAt])
  @@index([slug])
  @@map("jobs")
}

model JobSkill {
  id              String           @id @default(uuid())
  skillName       String           @db.VarChar(100)
  experienceYears Float
  isRequired      Boolean          @default(true)
  priority        JobSkillPriority @default(HIGH)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobId           String
  //* ==== relations ======>
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([skillName])
  @@index([isRequired])
  @@index([priority])
  @@map("job_skills")
}

//* ====== application & saved jobs/candidate ======>
model Application {
  id                     String                 @id @default(uuid())
  status                 ApplicationStatus      @default(SUBMITTED)
  coverLetter            String?
  preferredContactMethod PreferredContactMethod @default(EMAIL)
  rejectionReason        String?
  statusChangedBy        String?
  statusChangedAt        DateTime?
  applicantData          Json?
  folderName             String?                @db.VarChar(100)
  fullName               String?                @db.VarChar(100)
  email                  String?                @db.VarChar(200)
  phone                  String?                @db.VarChar(50)
  resumeUrl              String?
  agreedTerms            Boolean                @default(true)
  yearsOfExperience      Int?
  currentLocation        String?                @db.VarChar(255)
  interviewScheduledAt   DateTime?
  interviewNotes         String?
  withdrawnAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  applicantId            String
  jobId                  String
  //* ==== relations ======>
  applicant              User                   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  job                    Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notifications          Notification[]
  conversations          Conversation[]

  @@unique([jobId, applicantId])
  @@index([applicantId, status])
  @@index([jobId, status])
  @@index([createdAt])
  @@index([statusChangedAt])
  @@index([deletedAt])
  @@map("applications")
}

model SavedJob {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  folderName String?  @db.VarChar(100)
  notes      String?
  createdAt  DateTime @default(now())
  //* ==== relations ======>
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([folderName])
  @@map("saved_jobs")
}

model SavedCandidate {
  id          String   @id @default(uuid())
  employerId  String
  candidateId String
  folderName  String?  @db.VarChar(100)
  notes       String?
  createdAt   DateTime @default(now())
  //* ==== relations ======>
  employer    User     @relation("SavedCandidates", fields: [employerId], references: [id], onDelete: Cascade)
  candidate   User     @relation("SavedByEmployers", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([employerId, candidateId])
  @@index([employerId])
  @@index([candidateId])
  @@index([folderName])
  @@map("saved_candidates")
}

//* ====== messaging ======>
model Conversation {
  id                       String                    @id @default(uuid())
  applicationId            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  //* ==== relations ======>
  messages                 Message[]                 @relation("ConversationMessages")
  lastMessageId            String?                   @unique // Ensures one message can be last of at most one conversation
  lastMessage              Message?                  @relation("LastMessage", fields: [lastMessageId], references: [id])
  application              Application?              @relation(fields: [applicationId], references: [id])
  conversationParticipants ConversationParticipant[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  //* ==== relations ======>
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id                         String        @id @default(uuid())
  conversationId             String
  senderId                   String
  content                    String        @db.Text
  status                     MessageStatus @default(SENT)
  deliveredAt                DateTime?
  readAt                     DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  //* ==== relations ======>
  conversation               Conversation  @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender                     User          @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  lastMessageForConversation Conversation? @relation("LastMessage")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([status])
  @@map("messages")
}

//* ====== notification ======>
model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String           @db.VarChar(255)
  message       String
  isRead        Boolean          @default(false)
  jobId         String?
  applicationId String?
  sentVia       String[]         @default(["in_app"])
  emailSentAt   DateTime?
  pushSentAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  userId        String
  //* ==== relations ======>
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  job           Job?             @relation("JobNotifications", fields: [jobId], references: [id], onDelete: SetNull)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

//* ==== view & tracking ======>

model ProfileView {
  id           String   @id @default(uuid())
  viewerId     String?
  viewedUserId String
  viewedAt     DateTime @default(now())
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  //* ==== relations ======>
  viewer       User?    @relation("ViewerUser", fields: [viewerId], references: [id], onDelete: SetNull)
  viewedUser   User     @relation("ViewedUser", fields: [viewedUserId], references: [id], onDelete: Cascade)

  @@index([viewedUserId])
  @@index([viewerId])
  @@index([viewedAt])
  @@map("profile_views")
}

model JobView {
  id        String   @id @default(uuid())
  userId    String? // null if anonymous
  jobId     String
  viewedAt  DateTime @default(now())
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  //* ==== relations ======>
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([viewedAt])
  @@map("job_views")
}

model Follow {
  id         String   @id @default(uuid())
  userId     String
  companyId  String
  followedAt DateTime @default(now())
  //* ==== relations ======>
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("follows")
}

//* ===== subscription & billing ======>

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique @db.VarChar(100)
  description   String?
  price         Float
  currency      String   @default("USD")
  interval      String   @default("month")
  features      Json
  maxActiveJobs Int?
  maxUsers      Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  //* ==== relations ======>
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  companyId            String             @unique
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime
  endDate              DateTime?
  autoRenew            Boolean            @default(true)
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?            @unique
  paymentMethod        Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  //* ==== relations ======>
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  subscriptionId  String?
  invoiceNumber   String        @unique
  amount          Float
  currency        String        @default("USD")
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime?
  paidAt          DateTime?
  pdfUrl          String?       @db.VarChar(500)
  stripeInvoiceId String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  //* ==== relations ======>
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

//* ====== company settings ======>
model CompanySettings {
  id                 String  @id @default(uuid())
  companyId          String  @unique
  emailNotifications Boolean @default(true)
  applicationAlerts  Boolean @default(true)
  jobExpiryReminders Boolean @default(true)
  weeklyReports      Boolean @default(true)
  //* ==== privacy ====>
  profileVisibility  Boolean @default(true)
  showEmployeeCount  Boolean @default(true)
  allowDirectMessages Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //* ==== relations ======>
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

//* ====== user settings ======>
model UserSettings {
  id                 String            @id @default(uuid())
  userId             String            @unique
  jobRecommendations Boolean           @default(true)
  applicationUpdates Boolean           @default(true)
  messages           Boolean           @default(true)
  interviewUpdates   Boolean           @default(true)
  //* ==== privacy ====>
  profileVisibility  ProfileVisibility @default(PUBLIC)
  profileViews       Boolean           @default(true)
  searchVisibility   Boolean           @default(true)
  showEmail          Boolean           @default(false)
  showPhone          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  //* ==== relations ======>
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

//* ===== resume management =====>
model Resume {
  id         String   @id @default(uuid())
  userId     String
  fileName   String   @db.VarChar(255)
  fileUrl    String   @db.VarChar(500)
  fileSize   Int? // in bytes
  isDefault  Boolean  @default(false)
  uploadDate DateTime @default(now())
  deletedAt  DateTime?
  //* ==== relations ======>
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("resumes")
}

//* ====== tokens & logs ======>
model VerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique @db.VarChar(255)
  type      TokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  //* ==== relations ======>
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(255)
  action     String   @db.VarChar(50)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  userId     String?
  //* ==== relations ======>
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  id          String   @id @default(uuid())
  identifier  String   @db.VarChar(255)
  endpoint    String   @db.VarChar(255)
  requests    Int      @default(1)
  windowStart DateTime @default(now())
  resets      DateTime

  @@unique([identifier, endpoint])
  @@index([windowStart])
  @@index([resets])
  @@map("rate_limits")
}

model Address {
  id         String   @id @default(uuid())
  profileId  String   @unique
  street     String?  @db.VarChar(255)
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  zipCode    String?  @db.VarChar(20)
  country    String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Volunteer {
  id           String    @id @default(uuid())
  profileId    String
  role         String    @db.VarChar(255)
  organization String    @db.VarChar(255)
  cause        String?   @db.VarChar(255)
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("volunteers")
}

model Award {
  id          String    @id @default(uuid())
  profileId   String
  title       String    @db.VarChar(255)
  issuer      String    @db.VarChar(255)
  issueDate   DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("awards")
}

model Publication {
  id          String    @id @default(uuid())
  profileId   String
  title       String    @db.VarChar(255)
  publisher   String    @db.VarChar(255)
  publishDate DateTime?
  link        String?   @db.VarChar(500)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("publications")
}

model Reference {
  id          String   @id @default(uuid())
  profileId   String
  name        String   @db.VarChar(255)
  relationship String   @db.VarChar(255)
  company     String?  @db.VarChar(255)
  position    String?  @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("references")
}

model Language {
  id         String   @id @default(uuid())
  profileId  String
  language   String   @db.VarChar(100)
  proficiency String   @db.VarChar(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("languages")
}

model LegalDocument {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  intro       String   @db.Text
  content     String   @db.Text
  lastUpdated String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("legal_documents")
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  OPEN
  PENDING
  RESOLVED
  DISMISSED
}

model JobReport {
  id         String         @id @default(uuid())
  jobId      String
  reporterId String
  reason     String         @db.VarChar(255)
  comment    String?        @db.Text
  severity   ReportSeverity @default(LOW)
  status     ReportStatus   @default(OPEN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id])

  @@index([jobId])
  @@index([reporterId])
  @@index([status])
  @@map("job_reports")
}

model SystemSettings {
  id                   String   @id @default(uuid())
  aiMatchmaking        Boolean  @default(true)
  publicRegistration   Boolean  @default(true)
  globalNotifications  Boolean  @default(true)
  extendedAuditLogging Boolean  @default(true)
  maintenanceMode      Boolean  @default(false)
  siteName             String   @default("Workly")
  siteSlogan           String?
  siteLogo             String?
  supportEmail         String?
  updatedAt            DateTime @updatedAt

  @@map("system_settings")
}
