// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  role              UserRole          @default(JOB_SEEKER)
  isVerified        Boolean           @default(false)
  isActive          Boolean           @default(true)
  profileId         String?           @unique
  profileVisibility ProfileVisibility @default(PUBLIC)
  companyId         String?
  lastLogin         DateTime?
  deletedAt         DateTime?
}

model Profile {
  id          String       @id @default(uuid())
  userId      String       @unique
  fullName    String
  phone       String?
  bio         String?
  location    String?
  avatarUrl   String?
  coverUrl    String?
  resumeUrl   String?
  linkedInUrl String?
  websiteUrl  String?
  skills      Skill[]
  Preference  Preference[]
}

model Skill {
  id              String  @id @default(uuid())
  skillName       String  @db.VarChar(255)
  experienceYears Float
  profile         Profile @relation(fields: [profileId], references: [id])
  profileId       String
}

model Preference {
  id                String   @id @default(uuid())
  profile           Profile  @relation(fields: [profileId], references: [id])
  profileId         String
  jobType           JobType  @default(FULL_TIME)
  expectedSalary    Float?
  preferredLocation String?
  remoteWork        Boolean  @default(false)
  industry          String?
  workExperience    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id           String       @id @default(uuid())
  name         String       @unique
  slug         String
  description  String?
  websiteUrl   String?
  logoUrl      String?
  coverUrl     String?
  location     String?
  industry     String?
  size         String?
  contactEmail String?
  contactPhone String?
  isVerified   Boolean      @default(false)
  verifiedAt   DateTime?
  SocialLink   SocialLink[]
  benefits     String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // employees  
  // jobs        
  Job          Job[]
}

model SocialLink {
  id        String  @id @default(uuid())
  platform  String
  url       String
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
}

model Job {
  id                    String    @id @default(uuid())
  title                 String
  slug                  String
  discipline            String
  requirements          String
  jobType               JobType   @default(FULL_TIME)
  location              String
  experienceLevel       String
  isRemote              Boolean   @default(false)
  salaryMin             Float?
  salaryMax             Float?
  currency              String?
  contactEmail          String?
  applicationDeadline   DateTime?
  maxApplications       Int?
  autoCloseApplications Boolean   @default(false)
  isActive              Boolean   @default(true)
  isFeatured            Boolean   @default(false)
  expiresAt             DateTime?
  viewCount             Int       @default(0)
  applyCount            Int       @default(0)
  deletedAt             DateTime?
  // skillsRequired 
  benefits              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  postedById            String
  // applications          Application[]
  // savedByUsers          
  // notifications
}

model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  jobId         String?
  applicationId String?
  sentVia       String[]
  emailSentAt   DateTime?
  pushSentAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  userId        String
}

model Application {
  id                     String                 @id @default(uuid())
  status                 ApplicationStatus      @default(SUBMITTED)
  coverLetter            String?
  preferredContactMethod PreferredContactMethod @default(email)
  rejectionReason        String?
  statusChangedBy        String?
  statusChangedAt        DateTime?
  applicantData          Json
  folderName             String?
  interviewScheduledAt   DateTime?
  interviewNotes         String?
  withdrawnAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  applicantId            String
  jobId                  String
  userId                 String
  // notifications       
}

model SavedJob {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  folderName String?
  notes      String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValues  Json
  newValues  Json
  userId     String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())
}

//! =============================== enums ===============================>

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGE
  NEW_JOB_MATCH
  JOB_EXPIRING
  JOB_CLOSED
  MESSAGE_RECEIVED
  SYSTEM_ANNOUNCEMENT
  PROFILE_INCOMPLETE
  INTERVIEW_SCHEDULED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  REJECTED
  OFFERED
  ACCEPTED
  WITHDRAWN
}

enum PreferredContactMethod {
  email
  phone
  both
}
