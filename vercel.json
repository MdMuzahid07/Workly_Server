{
  "version": 2,
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/server.js"
    }
  ],
  "installCommand": "yarn install",
  "buildCommand": "yarn prisma:generate && yarn build",
  "outputDirectory": "dist"
}
