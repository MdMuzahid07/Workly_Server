
# ============================================
# Runtime
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database
# ============================================
# Local: postgresql://postgres:password@localhost:5432/workly
# Neon:  postgresql://user:pass@host/db?sslmode=require
#
# Docker bridge network setup:
POSTGRES_DB=workly
DB_USER=workly_admin
DB_PASSWORD=workly_strong_password_change_me_in_production

# Note on TLS/sslmode:
# Prisma 7 defaults to strict TLS validation (rejectUnauthorized: true).
# - For Docker bridge network (internal container-to-container), use:
#   postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# - For Managed Postgres in production (Neon, Supabase, etc.), use:
#   sslmode=require or proper CA verification (e.g. via DB_CA_CERT_PATH).
# - DO NOT set rejectUnauthorized=false in production.
DATABASE_URL=

# Path to CA cert for self-hosted Postgres (P3 — TLS validation)
# Leave blank for managed cloud databases (Neon, Supabase, etc.)
# DB_CA_CERT_PATH=/path/to/postgres-ca.crt

# ============================================
# JWT (generate with: openssl rand -hex 32)
# ============================================
# Minimum 32 characters enforced at startup
JWT_SECRET=<run: openssl rand -hex 32>
JWT_REFRESH_SECRET=<run: openssl rand -hex 32>
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ============================================
# Cookie signing (generate with: openssl rand -hex 32)
# ============================================
# Minimum 32 characters enforced at startup
COOKIE_SECRET=<run: openssl rand -hex 32>

# ============================================
# bcrypt
# ============================================
# P2: 13 rounds recommended (OWASP 2025/2026); was 12
BCRYPT_SALT_ROUNDS=13

# ============================================
# CORS
# ============================================
# Exact origins only — no substrings, no wildcards
# Add SSLCommerz real origin here (e.g. https://sandbox.sslcommerz.com) if needed
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ============================================
# URLs
# ============================================
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ============================================
# SMTP
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=

# ============================================
# Cloudinary
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# SSLCommerz
# ============================================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_LIVE=false

# ============================================
# Redis / Valkey
# ============================================
# When absent, rate limiter falls back to in-memory store (single-process only).
# Set before scaling to multiple processes or replicas.
# Local host access: valkey://localhost:6379 or redis://127.0.0.1:6379
# Docker internal network access: valkey://valkey:6379
REDIS_URL=
QUEUE_REDIS_URL=

# Concurrency configurations for background worker queues (BullMQ)
EMAIL_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=5
ANALYTICS_WORKER_CONCURRENCY=5
