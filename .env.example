# ==============================================================================
# ENVIRONMENT & RUNTIME CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000

# ==============================================================================
# DATABASE CONFIGURATION (Prisma & PostgreSQL)
# ==============================================================================
# ------------------------------------------------------------------------------
# MODE 1: NON-DOCKERIZED / Direct Local / Cloud Database
# ------------------------------------------------------------------------------
# A) Managed Cloud Database (Neon / Supabase / Render / ElephantSQL):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# B) Direct Native Local Postgres (Running on host machine, outside Docker):
DATABASE_URL=postgresql://postgres:password@localhost:5432/workly

# ------------------------------------------------------------------------------
# MODE 2: DOCKERIZED ENVIRONMENT (Running via docker-compose)
# ------------------------------------------------------------------------------
# Uncomment this block ONLY when running server inside Docker containers:
# POSTGRES_DB=workly
# DB_USER=workly_admin
# DB_PASSWORD=workly_strong_password_2026
# DATABASE_URL=postgresql://workly_admin:workly_strong_password_2026@postgres:5432/workly

# Path to CA cert for self-hosted Postgres (TLS validation) - leave blank for Neon/Cloud
# DB_CA_CERT_PATH=/path/to/postgres-ca.crt

# ==============================================================================
# REDIS / VALKEY CONFIGURATION (Caching & Rate Limiting)
# ==============================================================================
# ------------------------------------------------------------------------------
# MODE 1: NON-DOCKERIZED
# ------------------------------------------------------------------------------
# When REDIS_URL is commented out, rate limiter falls back to in-memory store.
# If running Redis/Valkey locally on host outside Docker, uncomment below:
# REDIS_URL=redis://localhost:6379
# QUEUE_REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# MODE 2: DOCKERIZED ENVIRONMENT (Running via docker-compose with Valkey service)
# ------------------------------------------------------------------------------
# REDIS_URL=valkey://valkey:6379
# QUEUE_REDIS_URL=valkey://valkey:6379

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT & Cookies)
# ==============================================================================
# Minimum 32 characters enforced at startup (generate with: openssl rand -hex 32)
JWT_SECRET=<run: openssl rand -hex 32>
JWT_REFRESH_SECRET=<run: openssl rand -hex 32>
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

COOKIE_SECRET=<run: openssl rand -hex 32>
BCRYPT_SALT_ROUNDS=13

# ==============================================================================
# SERVER URLs & CORS
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# THIRD-PARTY SERVICES & INTEGRATIONS
# ==============================================================================

# --- SMTP (Email Dispatcher) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# --- Cloudinary (Image & Media Asset Storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- SSLCommerz Payment Gateway ---
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWD=your-store-passwd
SSLCOMMERZ_IS_LIVE=false
